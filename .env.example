# NAS 上要看的照片目录（群晖上的绝对路径，例如 /volume1/photo/2026）
# 也是 yandere 抓图存图的地方（原来 /media/yandere 那个目录）
PHOTOS_DIR=/volume1/photo

# 喜欢的照片保存到这里（群晖上的绝对路径，例如 /volume1/photo/收藏夹）
DEST_DIR=/volume1/photo/收藏夹

# ---- yandere 抓图（v1.17，默认开）----
# 总开关：0 关掉抓图，只看图
YANDERE_ENABLED=1
# 每多少小时跑一轮（默认 6）
YANDERE_INTERVAL_HOURS=6
# 回填窗口：往前几天（默认 4；今天、昨天每轮都拉，往前 2-4 天只在对应
# 日期文件夹不存在或为空时才回填）
YANDERE_DAYS_BACK=4
# 请求间隔（秒）：列表之间、图片之间各停这么久再加 0-1 秒随机抖动
YANDERE_LIST_DELAY=2
YANDERE_IMAGE_DELAY=1.5
